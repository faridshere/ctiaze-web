# ctiaze-web (skopnix.com) — copy to .env.local (gitignored, never committed).
# Production values live in the Vercel project (Settings → Environment Variables).
# Env vars bind at BUILD time: after changing one on Vercel, redeploy.
#
# The live site needs the first three. Everything else is optional or belongs to
# shelved code under app/_disabled and lib/_disabled.

# Read path for every page, feed and sitemap (lib/db.ts). Use an Atlas user with
# the "read" role on database "ctiaze" ONLY — never the pipeline's user.
MONGO_URI_READONLY=mongodb+srv://<read-only-user>:<password>@<cluster-host>/ctiaze

# Write path for signups and the visit beacon (lib/db-write.ts). A separate Atlas
# user with readWrite on "ctiaze". Unset ⇒ the form answers 503 and stores nothing.
MONGO_URI_WRITE=mongodb+srv://<readwrite-user>:<password>@<cluster-host>/ctiaze

# Login token for /admin (lib/admin-auth.ts). Unset ⇒ nobody can log in (fails closed).
ADMIN_TOKEN=

# Optional — HMAC key for the proof-of-work challenges (lib/pow.ts). Falls back to a
# constant in the bundle; set it in production so challenges cannot be minted offline.
POW_SECRET=

# Optional — shared rate-limit counter across serverless instances (lib/ratelimit.ts).
# Without these the limiter is per-instance (documented tradeoff in RUNBOOK.md).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shelved features only (app/_disabled, lib/_disabled) — leave blank until re-enabled:
NVD_API_KEY=        # stacknix matcher: raises NVD from 5 to 50 requests / 30 s
STACKNIX_KEYS=      # comma-separated Builder keys for /api/stacknix
HIBP_API_KEY=       # scan-me breach lookup
THREATFOX_API_KEY=  # IOC enrichment

# Scripts only, never read by the app:
# HEALTH_BASE=https://ctiaze-web.vercel.app   # default target of scripts/health-check.mjs and verify-waitlist.mjs
# RESTORE_URI=                                 # scripts/db-backup.mjs restore target (refuses to run without it)
