{
  "name": "ctiaze-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "e2e": "playwright test",
    "health": "node scripts/health-check.mjs",
    "db:backup": "node scripts/db-backup.mjs backup \"$HOME/Desktop/skopnix-db-backup/$(date +%F)\"",
    "db:verify": "node scripts/db-backup.mjs verify \"$HOME/Desktop/skopnix-db-backup/$(date +%F)\"",
    "db:restore": "node scripts/db-backup.mjs restore"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  }
}
